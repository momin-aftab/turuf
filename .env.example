# Turuf Online — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git.

# ─── Authentication ───────────────────────────────────────────────────────────
# Must be at least 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# From Upstash console → your database → REST API
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Ably ────────────────────────────────────────────────────────────────────
# Root API key (server-side only — NEVER expose this to the client)
ABLY_API_KEY=

# Publishable key prefix for client-side Ably token requests
# Format: "appId.keyId" (no secret portion)
NEXT_PUBLIC_ABLY_KEY=

# ─── Sentry (Error Reporting) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for generating lobby join links
NEXT_PUBLIC_APP_URL=http://localhost:3000
